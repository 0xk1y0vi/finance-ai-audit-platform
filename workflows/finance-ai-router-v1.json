    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.payload || {};\n\nconst items = payload.items || [];\n\nconst expectedSubtotal = items.reduce(\n  (sum, item) => sum + Number(item.amount || 0),\n  0\n);\n\nconst expectedGST = Math.round(expectedSubtotal * 0.18);\n\nconst expectedGrandTotal = expectedSubtotal + expectedGST;\n\nconst providedSubtotal = Number(payload.subtotal || 0);\nconst providedGST = Number(payload.gst || 0);\nconst providedGrandTotal = Number(payload.grand_total || 0);\n\nconst subtotalMatch = expectedSubtotal === providedSubtotal;\nconst gstMatch = expectedGST === providedGST;\nconst grandTotalMatch = expectedGrandTotal === providedGrandTotal;\n\nconst validationPassed =\n  subtotalMatch &&\n  gstMatch &&\n  grandTotalMatch;\n\nconst failedChecks = [\n  !subtotalMatch,\n  !gstMatch,\n  !grandTotalMatch\n].filter(Boolean).length;\n\nconst riskAssessment =\n  failedChecks === 0\n    ? \"LOW\"\n    : failedChecks === 1\n      ? \"MEDIUM\"\n      : \"HIGH\";\n\nreturn {\n  json: {\n    agent: $json.agent,\n    data: $json.data,\n\n    validationPassed,\n\n    validationData: {\n      invoice_number: payload.invoice_number,\n\n      subtotalMatch,\n      gstMatch,\n      grandTotalMatch,\n\n      expectedSubtotal,\n      providedSubtotal,\n\n      expectedGST,\n      providedGST,\n\n      expectedGrandTotal,\n      providedGrandTotal,\n\n      failedChecks,\n      riskAssessment\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        -96
      ],
      "id": "5eb04383-8040-4d2d-a879-57c481723ef7",
      "name": "Calculation-Logic(Invoice-Verifier)"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.payload || {};\n\nconst subtotal = Number(payload.subtotal || 0);\n\nconst expectedGST = Math.round(subtotal * 0.18);\n\nconst providedGST = Number(payload.gst_amount || 0);\n\nconst gstRateMatch =\n  Number(payload.gst_rate || 0) === 18;\n\nconst gstAmountMatch =\n  providedGST === expectedGST;\n\nconst gstinPresent =\n  Boolean(payload.gstin);\n\nconst validationPassed =\n  gstRateMatch &&\n  gstAmountMatch &&\n  gstinPresent;\n\nconst failedChecks = [\n  !gstRateMatch,\n  !gstAmountMatch,\n  !gstinPresent\n].filter(Boolean).length;\n\nconst riskAssessment =\n  failedChecks === 0\n    ? \"LOW\"\n    : failedChecks === 1\n      ? \"MEDIUM\"\n      : \"HIGH\";\n\nreturn {\n  json: {\n    agent: $json.agent,\n    data: $json.data,\n\n    validationPassed,\n\n    validationData: {\n      invoice_number: payload.invoice_number,\n\n      gstRateMatch,\n      gstAmountMatch,\n      gstinPresent,\n\n      expectedGST,\n      providedGST,\n\n      failedChecks,\n      riskAssessment\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        64
      ],
      "id": "3630de61-8338-4d73-a8ce-563cea6ba17f",
      "name": "Calculation-Logic(GST-Validator)"
