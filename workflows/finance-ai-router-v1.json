    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.payload || {};\n\nconst vendorNamePresent = Boolean(payload.vendor_name);\nconst gstinPresent = Boolean(payload.gstin);\nconst panPresent = Boolean(payload.pan);\nconst bankPresent = Boolean(payload.bank_account);\n\nconst validationPassed =\n  vendorNamePresent &&\n  gstinPresent &&\n  panPresent &&\n  bankPresent;\n\nconst failedChecks = [\n  !vendorNamePresent,\n  !gstinPresent,\n  !panPresent,\n  !bankPresent\n].filter(Boolean).length;\n\nconst riskAssessment =\n  failedChecks === 0\n    ? \"LOW\"\n    : failedChecks === 1\n      ? \"MEDIUM\"\n      : \"HIGH\";\n\nreturn {\n  json: {\n    agent: $json.agent,\n    data: $json.data,\n\n    validationPassed,\n\n    validationData: {\n      vendor_name: payload.vendor_name,\n\n      vendorNamePresent,\n      gstinPresent,\n      panPresent,\n      bankPresent,\n\n      failedChecks,\n      riskAssessment\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        224
      ],
      "id": "a7e588e6-5e32-4352-bb2e-dacd9ff5f246",
      "name": "Calculation-Logic( Vendor-Compliance )"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json.payload || {};\n\nconst poNumberPresent = Boolean(payload.po_number);\n\nconst poAmount = Number(payload.po_amount || 0);\nconst invoiceAmount = Number(payload.invoice_amount || 0);\n\nconst poAmountPresent = poAmount > 0;\nconst invoiceAmountPresent = invoiceAmount > 0;\n\nconst invoiceWithinLimit =\n  invoiceAmount <= poAmount;\n\nconst validationPassed =\n  poNumberPresent &&\n  poAmountPresent &&\n  invoiceAmountPresent &&\n  invoiceWithinLimit;\n\nconst failedChecks = [\n  !poNumberPresent,\n  !poAmountPresent,\n  !invoiceAmountPresent,\n  !invoiceWithinLimit\n].filter(Boolean).length;\n\nconst riskAssessment =\n  failedChecks === 0\n    ? \"LOW\"\n    : failedChecks === 1\n      ? \"MEDIUM\"\n      : \"HIGH\";\n\nreturn {\n  json: {\n    agent: $json.agent,\n    data: $json.data,\n\n    validationPassed,\n\n    validationData: {\n      po_number: payload.po_number,\n\n      poNumberPresent,\n      poAmountPresent,\n      invoiceAmountPresent,\n      invoiceWithinLimit,\n\n      po_amount: poAmount,\n      invoice_amount: invoiceAmount,\n\n      failedChecks,\n      riskAssessment\n    }\n  }\n};"
      },
